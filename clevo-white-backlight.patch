+static int clevo_acpi_get_specs(u8 *type)
+{
+	union acpi_object arg = { .integer.type = ACPI_TYPE_INTEGER, .integer.value = 0 };
+	union acpi_object *result = NULL;
+	int status;
+
+	if (IS_ERR_OR_NULL(active_driver_data))
+		return -ENODEV;
+	status = clevo_acpi_evaluate(active_driver_data->adev, 0x0d, arg, &result);
+	if (status)
+		return status;
+	if (!result || result->type != ACPI_TYPE_BUFFER || result->buffer.length <= 0x0f) {
+		ACPI_FREE(result);
+		return -ENODATA;
+	}
+	*type = result->buffer.pointer[0x0f];
+	ACPI_FREE(result);
+	return 0;
+}
+
