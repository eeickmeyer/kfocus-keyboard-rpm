+static int clevo_detect_backlight(void)
+{
+	u32 features;
+	int err, i;
+
+	clevo_backlight_type = 0;
+	clevo_white_max = 2;
+	for (i = 0; i < 3; i++) {
+		if (!active_clevo_interface->get_specs)
+			break;
+		err = active_clevo_interface->get_specs(&clevo_backlight_type);
+		if (err || clevo_backlight_type)
+			break;
+		msleep(50);
+	}
+	if (!clevo_backlight_type) {
+		err = clevo_evaluate_method(CLEVO_METHOD_GET_BIOS_FEATURES_1, 0, &features);
+		if (err)
+			return err;
+		if (features & CLEVO_FEATURE_3_ZONE_RGB_KEYBOARD)
+			clevo_backlight_type = CLEVO_BACKLIGHT_3_ZONE_RGB;
+		else if (features & CLEVO_FEATURE_WHITE_KEYBOARD)
+			clevo_backlight_type = CLEVO_BACKLIGHT_FIXED_COLOR;
+	}
+	if (clevo_backlight_type == CLEVO_BACKLIGHT_FIXED_COLOR) {
+		err = clevo_evaluate_method(CLEVO_METHOD_GET_BIOS_FEATURES_2, 0, &features);
+		if (err)
+			TUXEDO_ERROR("Cannot detect white keyboard brightness range: %d\n", err);
+		else if (features & CLEVO_FEATURE_WHITE_FIVE_LEVELS)
+			clevo_white_max = 5;
+	}
+	return 0;
+}
