+static int set_brightness(u8 brightness)
+{
+	int err;
+
+	mutex_lock(&clevo_kbd_backlight_lock);
+	err = clevo_set_brightness(brightness);
+	if (!err)
+		clevo_kbd_brightness_notify();
+	mutex_unlock(&clevo_kbd_backlight_lock);
+	return err;
