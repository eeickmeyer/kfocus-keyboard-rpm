+static struct led_classdev clevo_kbd_backlight;
+static DEFINE_MUTEX(clevo_kbd_backlight_lock);
+static bool clevo_kbd_backlight_registered;
+
+static enum led_brightness clevo_kbd_brightness_get(struct led_classdev *led)
+{
+	enum led_brightness brightness;
+
+	mutex_lock(&clevo_kbd_backlight_lock);
+	brightness = kbd_led_state.enabled ? kbd_led_state.brightness : 0;
+	mutex_unlock(&clevo_kbd_backlight_lock);
+	return brightness;
+}
+
+/* Caller holds clevo_kbd_backlight_lock. */
+static void clevo_kbd_brightness_notify(void)
+{
+	if (clevo_kbd_backlight_registered)
+		led_classdev_notify_brightness_hw_changed(&clevo_kbd_backlight,
+			kbd_led_state.enabled ? kbd_led_state.brightness : 0);
+}
