 static int clevo_keyboard_probe(struct platform_device *dev)
 {
+	int err;
+
 	clevo_keyboard_init_device_interface(dev);
 	clevo_keyboard_init();
 
+	clevo_kbd_backlight.name = "clevo::kbd_backlight";
+	clevo_kbd_backlight.max_brightness = BRIGHTNESS_MAX;
+	clevo_kbd_backlight.brightness_get = clevo_kbd_brightness_get;
+	clevo_kbd_backlight.brightness_set_blocking = clevo_kbd_brightness_set;
+	clevo_kbd_backlight.flags = LED_BRIGHT_HW_CHANGED | LED_RETAIN_AT_SHUTDOWN;
+	err = led_classdev_register(&dev->dev, &clevo_kbd_backlight);
+	if (err) {
+		dev_err(&dev->dev, "Failed to register keyboard backlight LED: %d\n", err);
+	} else {
+		mutex_lock(&clevo_kbd_backlight_lock);
+		WRITE_ONCE(clevo_kbd_backlight_registered, true);
+		mutex_unlock(&clevo_kbd_backlight_lock);
+	}
+
 	return 0;
 }
 
